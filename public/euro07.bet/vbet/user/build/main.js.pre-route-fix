function applyLiveCoefs(payload){if(!payload||payload.game_id==null)return;const g=cache.find(x=>String(x.id)===String(payload.game_id));if(!g)return;const map={};(payload.coefs||[]).forEach(c=>{map[String(c.coef_id)]=String(c.odd)});if(typeof g.odd==='string'){g.odd=g.odd.split(',').map(part=>{const p=part.split('|');if(p.length>=4&&map[String(p[0])]!==undefined)p[1]=map[String(p[0])];return p.join('|')}).join(',')}if(payload.current_result!=null)g.result=payload.current_result;renderLive(cache);renderSlip()}
function applyLiveGame(payload){
  if(!payload)return;
  const item=payload.game||payload;
  if(Array.isArray(item)){item.forEach(applyLiveGame);return}
  if(item.id==null)return;
  const i=cache.findIndex(x=>String(x.id)===String(item.id));
  if(i<0){cache.push({...item});syncLiveClock(item)}
  else{
    const prev=cache[i];
    const merged={...prev,...item};
    // Keep a newer local/API clock when an older websocket snapshot arrives.
    const prevClock=liveClockState.get(String(item.id));
    const incomingSec=clockToSeconds(item.current_minute??item.game_time);
    const prevStatus=prev?.api_status??prev?.game_status;
    const nextStatus=item?.api_status??item?.game_status;
    if(prevClock && String(prevStatus)===String(nextStatus) && String(nextStatus)==='1' && incomingSec!==null && incomingSec<prevClock.base){
      merged.current_minute=prev.current_minute??merged.current_minute;
    }
    cache[i]=merged;
    syncLiveClock(merged);
  }
  renderLive(cache);
  renderSlip();
  if(String(openLiveGameId)===String(item.id)){const g=cache[i<0?cache.length-1:i];if(g)refreshLiveMarkets(g,true)}
}
