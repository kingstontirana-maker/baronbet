# Copy to .env and fill in the values from GSDeluxe. .env is never committed.
# Until every required key below is set the casino stays off (LOJRA shows "Casino nuk është aktive").

# --- Required: GSDeluxe API (from their Admin page / GSDeluxe) ---
GSD_TOKEN_NAME=
GSD_TOKEN_VALUE=
GSD_API_HASH_KEY=
GSD_CLUB_ID=

# --- Required for seamless mode (default) ---
# secret_key used in sha1(command + timestamp + secret_key)
GSD_CALLBACK_SECRET=
# Comma-separated IPs GSDeluxe calls from. Use * only for testing.
GSD_CALLBACK_IPS=

# --- Optional ---
# GSD_MODE=transfer            # use balance_operation instead of the seamless callbacks
# GSD_TRUST_PROXY=true         # behind nginx/Cloudflare: take the caller IP from X-Forwarded-For
# GSD_API_URL=https://api.gsdeluxe.com/api.php
# GSD_ENABLED=false            # stops new games
# GSD_LOGIN_PREFIX=bb          # prefix of player logins created at GSDeluxe
# GSD_GAME_DENOMINATION=0.01   # start_game denomination (1 cent minimum bet)
# GSD_BALANCE_DENOMINATION=100 # transfer mode only: "denomenation" for balance_operation
