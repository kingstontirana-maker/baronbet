# Copy to .env and fill in the values from GSDeluxe. .env is never committed.
# Until every required key below is set the casino stays off (LOJRA shows "Casino nuk është aktive").

# --- Required: GSDeluxe API (from their Admin page / GSDeluxe) ---
GSD_TOKEN_NAME=
GSD_TOKEN_VALUE=
GSD_API_HASH_KEY=
GSD_CLUB_ID=

# --- Optional for the seamless callbacks ---
# secret_key of sha1(command + timestamp + secret_key). Empty: the hash is checked against
# GSD_API_HASH_KEY and GSD_TOKEN_VALUE, and only correctly signed callbacks are accepted.
# GSD_CALLBACK_SECRET=
# Comma-separated GSDeluxe callback IPs. Empty: signed callbacks from any IP; each new IP
# is reported in the center alerts so it can be pinned here.
# GSD_CALLBACK_IPS=

# --- Recommended: dedicated game host ---
# A subdomain pointed at this same app (e.g. https://lojra.tirana99.tech). Games then run in an
# origin of their own (storage and cookies work) and can never read the player's site session.
# That host serves game frames only. Without it, games run in an opaque sandbox and some stay black.
# GSD_FRAME_ORIGIN=https://lojra.tirana99.tech

# --- Optional ---
# GSD_MODE=transfer            # use balance_operation instead of the seamless callbacks
# GSD_TRUST_PROXY=true         # behind nginx/Cloudflare: take the caller IP from X-Forwarded-For
# GSD_API_URL=https://api.gsdeluxe.com/api.php
# GSD_ENABLED=false            # stops new games
# GSD_LOGIN_PREFIX=bb          # prefix of player logins created at GSDeluxe
# GSD_GAME_DENOMINATION=       # start_game denomination; leave empty to use the club setting
# GSD_BALANCE_DENOMINATION=100 # transfer mode only: "denomenation" for balance_operation
